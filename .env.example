# Sandbox Lab example environment configuration (copy to local runtime env if needed; never commit real keys)
SANDBOX_LAB_API_HOST=127.0.0.1
SANDBOX_LAB_API_PORT=18000
SANDBOX_LAB_WEB_PORT=5173
SANDBOX_LAB_NGINX_URL=http://127.0.0.1:18080
SANDBOX_LAB_TEST_SERVICE_URL=http://sandbox-lab-test-service:8081/ping
SANDBOX_LAB_TEST_SERVICE_HOST_URL=http://127.0.0.1:18081/ping
SANDBOX_LAB_DOCKER_NETWORK=sandbox_lab_net
SANDBOX_LAB_WORKER_IMAGE=sandbox-lab-worker:v1

# Optional LLM provider credentials for live Agent tool calling
# Choose one provider or set the key in your shell environment
SANDBOX_LAB_LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=replace-with-your-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
SANDBOX_LAB_MODEL=deepseek-flash
OPENAI_API_KEY=replace-with-your-key
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=replace-with-your-key
GEMINI_API_KEY=replace-with-your-key
